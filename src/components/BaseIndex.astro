---
import Layout from "@/layouts/Layout.astro";

import About from "@/components/sections/About.astro";
import Experience from "@/components/sections/Experience.astro";
import Hero from "@/components/sections/Hero.astro";
import Projects from "@/components/sections/Projects.astro";
import FreelanceProjects from "@/components/sections/FreelanceProjects.astro";
import PersonalProjects from "@/components/sections/PersonalProjects.astro";
import Skills from "@/components/sections/Skills.astro";
import Languages from "@/components/sections/Languages.astro";
import Interests from "@/components/sections/Interests.astro";
import Tail from "@/components/sections/Tail.astro";
import KeyboardManager from "@/components/KeyboardManager.astro";
import ThemeSwitch from "@/components/ThemeSwitch.astro";

import * as m from "../paraglide/messages.js";
import Education from "@/components/sections/Education.astro";
import Publications from "@/components/sections/Publications.astro";
---

<Layout title={m.page_title()}>
  <main
    class="max-sm:py-16 relative grid h-full max-w-7xl gap-12 p-8 md:min-h-screen md:grid-cols-6 md:p-16 xl:gap-24 print:!block print:!h-auto print:!min-h-0"
  >
    <div class="space-y-6 ease-in md:col-span-2 print:!block print:!space-y-4">
      <Hero />
      <ThemeSwitch />
      <About />
      <Languages />
      <Interests />
    </div>
    <div class="space-y-12 md:col-span-4 print:!block print:!space-y-6">
      <Experience className="print:break-before-page" />
      <Education className="print:break-before-page" />
      <Publications />
      <Skills />
      <Projects className="print:hidden" />
      <FreelanceProjects className="print:hidden" />
      <PersonalProjects className="print:hidden" />
    </div>
  </main>
  <div class="border-t border-solid border-skin-hue print:hidden"></div>
  <Tail />
  <KeyboardManager />
</Layout>

<script>
  const carousel = document.querySelector("#carousel");

  if (carousel) {
    let isScrolling = true;
    let scrollSpeed = 2;
    let direction = 1;
    let pauseTimeout: NodeJS.Timeout;

    const startAutoScroll = () => {
      const scroll = () => {
        if (!isScrolling) return;

        if (
          //@ts-ignore
          carousel.scrollLeft + carousel.offsetWidth >= carousel.scrollWidth ||
          carousel.scrollLeft <= 0
        ) {
          direction *= -1;
          isScrolling = false;
          clearTimeout(pauseTimeout);
          pauseTimeout = setTimeout(() => {
            isScrolling = true;
            requestAnimationFrame(scroll);
          }, 1000);
        }

        carousel.scrollLeft += scrollSpeed * direction;
        requestAnimationFrame(scroll);
      };

      requestAnimationFrame(scroll);
    };

    const stopAutoScroll = () => {
      isScrolling = false;
    };

    const handleUserInteraction = () => {
      stopAutoScroll();
      setTimeout(() => {
        isScrolling = true;
      }, 500);
    };

    startAutoScroll();

    carousel.addEventListener("mousedown", handleUserInteraction);
    carousel.addEventListener("wheel", handleUserInteraction);
    carousel.addEventListener("touchstart", handleUserInteraction);
  } else {
    console.log("Not in Scroll mode");
  }
</script>

<style>
  /* 自定义滚动条样式 */
  .scrollbar-thin::-webkit-scrollbar {
    height: 8px;
  }
  .scrollbar-thumb-gray-400::-webkit-scrollbar-thumb {
    background-color: #a0aec0;
    border-radius: 4px;
  }
</style>

<style is:global>
  * {
    scrollbar-color: var(--color-button-muted) var(--color-fill);
  }

  @page {
    size: auto;
    margin: 15mm 0mm 0mm 0mm;
  }
  main {
    margin: auto;
    width: 100%;
  }
</style>
