---
import { Icon } from "astro-icon/components";
import Section from "../Section.astro";

// ponytail: "Publications" is spelled the same in EN and FR, so no Paraglide key.
const publications = [
  {
    title:
      "Structural Biases in LLM-as-a-Judge Systems: Implications for reliable IS Adoption",
    authors: "Cédric Gaspoz, Ulysse Rosselet, Jonathan Piaget",
    venue: "AMCIS 2026, Reno, NV",
    year: "2026",
    url: "/amcis",
  },
];
---

<Section className={Astro.props.className} title="Publications">
  <ul class="space-y-4 py-3 print:space-y-0">
    {
      publications.map(({ title, authors, venue, year, url }) => (
        <div class="flex items-baseline">
          <Icon
            name="mdi:file-document-outline"
            class="mr-3 mt-1 hidden h-5 w-5 self-start md:inline-block"
          />
          <div class="relative w-full items-baseline justify-between gap-2">
            <h3 class="mr-6 items-baseline gap-x-2 gap-y-0.5 text-base font-medium">
              <a
                class="group flex items-center gap-[6px] text-skin-base decoration-dotted underline-offset-[5px] hover:text-skin-hue hover:underline"
                href={url}
              >
                {title}
                <span class="text-skin-hue transition ease-linear group-hover:-translate-y-0.5 group-hover:translate-x-0.5">
                  <Icon name="ri:arrow-up-line" class="rotate-45" />
                </span>
              </a>
            </h3>
            <div class="text-sm text-skin-muted">{authors}</div>
            <div class="text-sm text-skin-muted">{venue}</div>
            <time class="right-0 top-0 text-xs text-skin-muted md:absolute md:block">
              {year}
            </time>
          </div>
        </div>
      ))
    }
  </ul>
</Section>
