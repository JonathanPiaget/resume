---
import profile from "@/assets/profile.png";
import ArtPlums from "@/components/ArtPlums.astro";
import CV from "@cv";
import "@fancyapps/ui/dist/fancybox/fancybox.css";
import * as m from "../paraglide/messages.js";
import "../globals.css";

interface Props {
  title: string;
  description?: string;
}

const { url, theme } = CV.basics;

const { title, description = m.meta_description() } = Astro.props;

// Per-page absolute URLs, so shared links resolve to the page instead of the site root.
const canonical = new URL(Astro.url.pathname, Astro.site ?? url);
const ogImageUrl = new URL(profile.src, canonical);

// hreflang only on the index pages, the sole EN/FR pair.
const isIndex = ["/", "/fr", "/fr/"].includes(Astro.url.pathname);
const isRoot = Astro.url.pathname === "/";
const isFrench = Astro.currentLocale === "fr";

// JSON-LD. One entity (#me) shared by every page. `identity` only carries what
// every page renders; `person` adds the CV, so /amcis/ never claims invisible content
// (https://developers.google.com/search/docs/appearance/structured-data/sd-policies).
const siteUrl = `${url}/`;
const identity = {
  "@type": "Person",
  "@id": `${siteUrl}#me`,
  name: CV.basics.name,
  url: siteUrl,
  email: `mailto:${CV.basics.email}`,
  sameAs: [
    ...CV.basics.profiles.map((p) => p.url),
    "https://people.hes-so.ch/fr/profile/6187035740-jonathan-piaget",
    "https://people.he-arc.ch/jonathan.piaget",
    "https://x.com/jonpiaget",
  ],
};
const person = {
  ...identity,
  givenName: "Jonathan",
  familyName: "Piaget",
  image: ogImageUrl.href,
  jobTitle: m.label(),
  description: m.meta_description(),
  address: {
    "@type": "PostalAddress",
    addressLocality: "Neuchâtel",
    addressCountry: "CH",
  },
  // Same names and links as Experience.astro / Education.astro render.
  worksFor: [
    { "@type": "Organization", name: m.ido(), url: m.ido_url() },
    {
      "@type": "Organization",
      name: m.lcba(),
      url: "https://online.light-contact.ch/",
    },
  ],
  alumniOf: {
    "@type": "CollegeOrUniversity",
    name: "Haute Ecole de Gestion Arc",
  },
  knowsAbout: CV.skills.map((s) => s.name),
};
const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    // Google reads the site name from the domain root only.
    ...(isRoot
      ? [
          {
            "@type": "WebSite",
            "@id": `${siteUrl}#website`,
            name: CV.basics.name,
            url: siteUrl,
          },
        ]
      : []),
    isIndex
      ? {
          "@type": "ProfilePage",
          "@id": canonical.href,
          url: canonical.href,
          inLanguage: Astro.currentLocale,
          dateCreated: "2024-12-22T12:58:33-05:00",
          dateModified: new Date().toISOString(),
          mainEntity: person,
        }
      : identity,
  ],
});
---

<!doctype html>
<html lang={Astro.currentLocale}>
  <head>
    <meta charset="UTF-8" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/icon.png" />
    <link rel="canonical" href={canonical} />
    {
      isIndex && (
        <>
          <link rel="alternate" hreflang="en" href={new URL("/", canonical)} />
          <link
            rel="alternate"
            hreflang="fr"
            href={new URL("/fr/", canonical)}
          />
          <link
            rel="alternate"
            hreflang="x-default"
            href={new URL("/", canonical)}
          />
        </>
      )
    }
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content={CV.basics.name} />
    <meta property="og:locale" content={isFrench ? "fr_CH" : "en_US"} />
    <script type="application/ld+json" is:inline set:html={jsonLd} />
    <meta name="referrer" content="no-referrer" />
    <!-- X falls back to the og:* tags for title, description and image. -->
    <meta name="twitter:card" content="summary" />
    <script is:inline>
      // Applied before first paint so no page flashes the wrong theme.
      if (
        localStorage.theme === "dark" ||
        (!("theme" in localStorage) &&
          window.matchMedia("(prefers-color-scheme: dark)").matches)
      )
        document.documentElement.classList.add("dark");
    </script>
    {
      import.meta.env.PROD && (
        <script
          is:inline
          defer
          src="https://analytics.piagetjonathan.ch/script.js"
          data-website-id="d65f45e9-5eb7-4c64-82f8-844230f0826a"
        />
      )
    }
  </head>
  <body data-theme={theme} class="relative bg-skin-fill font-sans">
    <div class="absolute top-0 -z-10 h-full w-full print:hidden">
      <div
        class="absolute bottom-auto left-[20%] right-auto top-0 h-[200px] w-[200px] -translate-x-[30%] translate-y-[20%] rounded-full bg-skin-hue/10 blur-[80px] invert-0 dark:bg-white/5"
      >
      </div>
    </div>
    <ArtPlums />
    <slot />
    <style>
      body,
      figure {
        margin: 0;
        padding: 0;
      }

      a {
        text-decoration: none;
      }

      ul {
        list-style: none;
        margin: 0;
        padding: 0;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      h1,
      h2,
      h3,
      h4 {
        @apply font-sans text-skin-base;
        margin: 0;
      }

      p {
        @apply text-sm text-skin-muted;
        line-height: 1.5;
        text-wrap: pretty;
      }

      #hotkeypad [data-backdrop] {
        @apply !bg-zinc-800 !opacity-80;
      }

      ::-webkit-scrollbar {
        width: 2px;
      }

      @media print {
        astro-dev-toolbar {
          display: none !important;
        }

        article {
          break-inside: avoid;
        }

        /* Fix for CSS custom properties in print */
        * {
          -webkit-print-color-adjust: exact;
          print-color-adjust: exact;
        }

        /* Force white background in Chrome print */
        html,
        body {
          background: white !important;
          background-color: white !important;
        }
      }
    </style>
  </body>
</html>
